---
type Props = {
  header: string
  level?: 2 | 3 | 4 | 5 | 6
}

---

<section>
  <header>
    {Astro.props.level === 3 ? (
      <h3>{Astro.props.header}</h3>
    ) : Astro.props.level === 4 ? (
      <h4>{Astro.props.header}</h4>
    ) : Astro.props.level === 5 ? (
      <h5>{Astro.props.header}</h5>
    ) : Astro.props.level === 6 ? (
      <h6>{Astro.props.header}</h6>
    ) : (
      <h2>{Astro.props.header}</h2>
    )}
  </header>
  <slot />
</section>
